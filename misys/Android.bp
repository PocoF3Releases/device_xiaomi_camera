// Device-scoped compatibility clients. Do not replace any native MiSys prebuilts.
java_library {
    name: "xiaomi-misys",
    srcs: ["src/**/*.java"],
    static_libs: ["android.hidl.base-V1.0-java"],
    installable: true,
    required: ["xiaomi-misys.xml"],
}

prebuilt_etc {
    name: "xiaomi-misys.xml",
    src: "xiaomi-misys.xml",
    sub_dir: "permissions",
}
