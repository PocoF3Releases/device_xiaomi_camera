# Qigsaw installs Mimoji native splits into Camera's private data.
# Keep the executable-data exception separate from generic app_data_file.
type miui_camera_data_file, file_type, data_file_type, core_data_file_type, app_data_file_type;

allow platform_app_36 miui_camera_data_file:dir create_dir_perms;
allow platform_app_36 miui_camera_data_file:file { create_file_perms execute };
allow platform_app_36 miui_camera_data_file:lnk_file create_file_perms;
allow platform_app_36 miui_camera_data_file:fifo_file create_file_perms;
allow platform_app_36 miui_camera_data_file:sock_file create_file_perms;
